# Copiá este archivo a .env.local y completá los valores reales.
# .env.local nunca se commitea (ver .gitignore) — este archivo sí, como plantilla.

# Riot Games API — developer.riotgames.com → tu app → "Nueva clave API"
# Personal Key: no expira cada 24hs como la Development Key, pero igual
# se puede regenerar en el portal si se filtra.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Routing: la2=LAS, la1=LAN, na1, euw1, kr, ... (League-V4, platform-routed)
RIOT_PLATFORM=la2
# Routing: americas, europe, asia, sea (Account-V1 / Match-V5, region-routed)
RIOT_REGION=americas

# Supabase — Project Settings → API en supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key — SOLO server-side, nunca exponer al browser con NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic — console.anthropic.com → API Keys
# Solo hace falta para el "Análisis del pool" (POST /api/coach). Sin esta
# variable el resto de la app funciona igual; ese panel devuelve un error
# explicando que falta.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
