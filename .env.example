# Copiá este archivo a .env.local y completá los valores reales.
# .env.local nunca se commitea (ver .gitignore) — este archivo sí, como plantilla.

# Riot Games API — developer.riotgames.com → tu app → "Nueva clave API"
# Personal Key: no expira cada 24hs como la Development Key, pero igual
# se puede regenerar en el portal si se filtra.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Routing: la2=LAS, la1=LAN, na1, euw1, kr, ... (League-V4, platform-routed)
RIOT_PLATFORM=la2
# Routing: americas, europe, asia, sea (Account-V1 / Match-V5, region-routed)
RIOT_REGION=americas

# Supabase — Project Settings → API en supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key — SOLO server-side, nunca exponer al browser con NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic — console.anthropic.com → API Keys
# Solo hace falta para el "Análisis del pool" (POST /api/coach). Sin esta
# variable el resto de la app funciona igual; ese panel devuelve un error
# explicando que falta.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# La contraseña compartida del grupo. Protege TODO lo que escribe o cuesta:
# agregar invocadores, /api/refresh, /api/backfill, /api/repair, las cargadas
# al Discord y —la que importa— generar el informe del pool, que se paga por
# token. Mirar la app no la pide.
#
# SIN ESTA VARIABLE NADIE PUEDE ESCRIBIR. Es a propósito: que falte es
# exactamente el caso en el que no hay que dejar pasar a nadie.
#
# Cambiarla cierra todas las sesiones abiertas (la cookie va firmada con ella).
APP_PASSWORD=una-frase-larga-que-sepan-los-seis

# ── Discord ──────────────────────────────────────────────────────────────
# El webhook de siempre: por acá salen las rachas, los ascensos, las cargadas,
# el parte diario y el cierre de la liga. Si falta, las notificaciones quedan
# apagadas y la app funciona igual (es lo normal en local).
# Se saca en el canal → Editar canal → Integraciones → Webhooks.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/xxxxxxxxxxxxxxxx

# El bot de verdad. Las cuatro salen de discord.com/developers → tu aplicación.
#
# Con BOT_TOKEN + CHANNEL_ID los anuncios salen COMO el bot en vez de por el
# webhook, y eso destraba dos cosas que un webhook no puede hacer: dejar las
# reacciones puestas en una votación y editar un mensaje ya mandado. Si no
# están, todo cae al webhook y sigue andando como antes.
#
# PUBLIC_KEY es la cerradura de /api/discord/interactions: sin ella NO entra
# ningún comando (falla cerrado, igual que APP_PASSWORD).
DISCORD_BOT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DISCORD_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DISCORD_CHANNEL_ID=123456789012345678

# Para registrar el menú de comandos. APP_ID es el "Application ID" de General
# Information; GUILD_ID es el id del server (click derecho en el server con el
# modo desarrollador prendido). Sin GUILD_ID los comandos se registran globales
# y Discord tarda hasta una hora en mostrarlos.
#
# Van en Vercel también, no solo en local: el registro se puede disparar desde
# POST /api/discord/registrar, que es el camino cuando no hay una consola con
# Node a mano (ver scripts/registrar-comandos.mjs para el otro).
DISCORD_APP_ID=123456789012345678
DISCORD_GUILD_ID=123456789012345678

# El secreto de los crons. Lo exigen /api/cron/refresh, /api/cron/liga y el
# parte diario: van con `Authorization: Bearer $CRON_SECRET`. Sin esta variable
# esas rutas contestan 401 a todo el mundo, incluido el scheduler.
CRON_SECRET=otra-frase-larga-distinta-de-APP_PASSWORD
